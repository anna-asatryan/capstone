# =========================================================
# Python environments and local config
# =========================================================
.venv/
.venv-*/
venv/
env/

.env
.env.*
!.env.example

# Streamlit secrets
.streamlit/secrets.toml
**/.streamlit/secrets.toml
**/secrets.toml

# =========================================================
# Python cache / build artifacts
# =========================================================
__pycache__/
*.py[cod]
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# =========================================================
# Jupyter
# =========================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# =========================================================
# OS / editor
# =========================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================================================
# Logs
# =========================================================
*.log

# =========================================================
# Local/private project info
# =========================================================
CapstoneInfo/
outputs/

# =========================================================
# Raw data: keep folder + README, ignore only large local raw files
# =========================================================
data/raw/loan.csv
data/raw/lendingclub_raw_data.zip

# Optional compressed raw-data variants
data/raw/*.zip
data/raw/*.tar
data/raw/*.tar.gz
data/raw/*.gz

# Keep raw-data documentation and placeholders versioned
!data/raw/README.md
!data/raw/.gitkeep

# If you decide LCDataDictionary.xlsx should stay local-only, uncomment:
# data/raw/LCDataDictionary.xlsx

# =========================================================
# Local databases / dumps
# =========================================================
*.sqlite
*.sqlite3
*.db

# =========================================================
# Quarto / LaTeX / paper rendering intermediates
# Keep paper/ source and paper/paper.pdf trackable
# =========================================================
.quarto/
**/.quarto/

*_files/
**/*_files/

*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# =========================================================
# Rendered scratch outputs
# Do not ignore PDFs globally because paper/paper.pdf may be submitted
# =========================================================
*.html
*.docx